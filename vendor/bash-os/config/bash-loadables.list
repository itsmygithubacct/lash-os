# archives
pax|POSIX pax ustar archives: list, -w create, -r extract, -rw copy

# compression (libzstd loaded at run time; no link-time dependency)
zstd|zstd [-1..-19] [-d] [-c] [-f] [-k|--rm] [-o OUT] [FILE...]
zstdcat|zstdcat [FILE...]

# util-linux family (imported 2026-09-06 from the upstream collection)
flock|flock [-sxun] [-w SECONDS] [-E N] FD | FILE [command [args] | -c CMD]
setsid|Run a program in a new session
ionice|Get or set the I/O scheduling class and priority of a process
blockdev|Call block-device ioctls from the command line
ipcmk|Create System V IPC resources
ipcctl|Run gated System V IPC control operations
chattr|chattr [-R] [+-=]MODE file...
lsattr|List file attributes on a Linux filesystem
mkswap|mkswap [-L label] [-U uuid] [-p pagesize] [-f] device|file [size]
swapon|Enable a swap area, or list the active ones
swapoff|swapoff [-a] [device...]
wipefs|wipefs [-a] [-n] device...
fincore|fincore [-b|--bytes] [-n|--noheadings] FILE...
fsfreeze|Suspend or resume access to a filesystem
losetup|Set up and control loop devices
dmsetup|Low-level device-mapper control
getfacl|Display POSIX.1e file access control lists
setfacl|Set POSIX.1e file access control lists
fstrim|Discard unused blocks on a mounted filesystem
prlimit|prlimit --pid PID [-r RES [SOFT[:HARD]]] | --nofile=LIMIT COMMAND
hwclock|hwclock(8) subset over /dev/rtc0
renice|Change the niceness of running processes (POSIX renice)
taskset|Run or query commands with a CPU affinity mask
chrt|Show or change process scheduling policy and priority
uclampset|Show and change task or system utilization clamps

# text and formatting tools (imported 2026-09-06 from the upstream collection)
expand|Convert tabs to spaces (POSIX expand)
unexpand|Convert spaces to tabs (POSIX unexpand)
split|split [-l N | -b SIZE] [-a SUFLEN] [INPUT [PREFIX]]
csplit|Context-split a file (POSIX csplit)
join|Relational join on two sorted files (POSIX join)
pr|Format text for printing (POSIX pr)
tac|Concatenate and print files in reverse (last record first)
column|column [-x] [-c WIDTH] [-t [-s SEPSTR] [-o OUTSTR]] [FILE...]
col|Filter CTL-H overstrike sequences (util-linux col)
colrm|colrm [START [END]]
expr|Evaluate POSIX expr(1) expressions
hexdump|Byte-oriented hex dump (hexdump-compatible, focused on -C canonical)
bashclear|bashclear [-x] [-T TERM] | -V | --version | --help
clear|clear [-x] [-T TERM] | -V | --version | --help
tput|tput [-T TERM] CAP [ARGS...] | tput query CAP [-T TERM] [-V VAR] [ARGS...] | tput cap-list [-T TERM] [-V VAR] | tput entry-list | tput info [-T TERM]
tinfo|Read compiled terminfo entries
strings|Print printable character sequences from files or stdin
ed|ed [-s] [FILE]
ar|ar [-D|-U] -t|-x|-r|-q|-s|s ARCHIVE [FILE...]
uuencode|uuencode [-m] [FILE] NAME
uudecode|Decode traditional uuencode and base64-uuencode streams


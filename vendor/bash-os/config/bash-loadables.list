bashtermraw|bashtermraw raw|cooked|size|stty-g|stty-set STATE|keypress|cup ROW COL|clr-eol|clr-screen|clear|reset|show [on|off]|paste on|off
bashkmod|bashkmod
bashmount|bashmount [-t TYPE] [-o OPTS] [-B|-R|--remount|-u|-l|--mountpoint|--findmnt-table] SRC DST
bashlogger|bashlogger [-i] [-t TAG] [-p PRI] [MESSAGE...]
bashsyslogd|bashsyslogd
ls|ls [OPTION]... [FILE]...
cp|cp [-r] SRC... DST
mv|mv SRC... DST
touch|touch FILE...
find|find [PATH] [EXPR]

# bash-loadables-pure.list — the POSIX-utility baseline: the 28 loadables from
# GNU bash's own examples/loadables, taken from the pinned tarball at build
# time — except stat, cut and seq, which this repo's own MIT sources
# replace in every variant. The smallest useful bash-os:
#   ./build.sh --list config/bash-loadables-pure.list   ->  out/bash-pure
# Same NAME|short-doc grammar as bash-loadables.list (config/loadables.sh).

basename|basename
cat|cat
chmod|chmod [-Rfv] MODE FILE...
cut|cut -b LIST | -c LIST | -f LIST [-d DELIM] [-s] [-z] [--complement] [--output-delimiter=STRING] [-a ARRAY] [FILE...]
dirname|dirname [-z|--zero] [--] NAME...
head|head
id|id [-aGgnruz] [USER ...]
ln|ln
logname|logname [--help] [--version]
mkdir|mkdir [-p] [-m MODE] DIRECTORY...
mkfifo|mkfifo [-m mode] fifo_name [fifo_name ...]
mktemp|mktemp [-dqu] [-t PREFIX] [-v VAR] [TEMPLATE...]
pathchk|pathchk [-p] pathname ...
printenv|printenv [-0|--null] [--] [VARIABLE...]
realpath|realpath [-a varname] [-ceqsv] pathname [pathname...]
rm|rm
rmdir|rmdir [-p] DIRECTORY...
seq|seq [-w] [-s STRING] [-f FORMAT] [FIRST [INCREMENT]] LAST
sleep|sleep NUMBER[SUFFIX]...
stat|stat
strftime|strftime format [seconds]
strptime|strptime [-f format] date-time
sync|sync
tee|tee [-ai] [file ...]
tty|tty [-s]
uname|uname [-amnrsvpio]
unlink|unlink name
whoami|whoami [--help] [--version]

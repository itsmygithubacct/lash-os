+static int
+head_input (const char *name, const struct head_options *o, int header, int *printed)
+{
+  FILE *fp;
+  struct stat st;
+  off_t start;
+  int fd, standard, seekable, result, saved_errno;
+
+  standard = name == 0 || strcmp (name, "-") == 0;
+  /* Ownership follows how the descriptor was obtained, even if open returns
+     descriptor zero because shell stdin was closed. Never use global stdin. */
+  fd = standard ? fcntl (STDIN_FILENO, F_DUPFD_CLOEXEC, 3) : open (name, O_RDONLY);
+  if (fd < 0) goto open_error;
+  fp = fdopen (fd, "r");
+  if (fp == 0) { saved_errno = errno; close (fd); errno = saved_errno; goto open_error; }
+  start = lseek (fd, 0, SEEK_CUR);
+  seekable = start != (off_t)-1;
+  if (!seekable && !o->exclude) setvbuf (fp, NULL, _IONBF, 0);
+  result = 0;
+  if (header)
+    {
+      if (printf ("%s==> %s <==\n", *printed ? "\n" : "", standard ? "standard input" : name) < 0)
+        result = -1;
+      *printed = 1;
+    }
+  if (result == 0)
+    {
+      if (o->exclude && o->count == 0)
+        result = head_bytes (fp, UINTMAX_MAX);
+      else if (o->exclude && seekable && fstat (fd, &st) == 0 && S_ISREG (st.st_mode) && st.st_size > 0)
+        result = head_suffix (fp, o, start, st.st_size > start ? st.st_size : start);
+      else if (o->exclude)
+        result = head_tail_stream (fp, o);
+      else if (o->bytes)
+        result = head_bytes (fp, o->count);
+      else
+        result = head_lines (fp, o, seekable);
+    }
+  if (result < 0)
+    builtin_error ("%s: %s", standard ? "standard input" : name, strerror (errno));
+  /* Return all stdio read-ahead to the shared seekable descriptor. */
+  if (seekable && fseeko (fp, 0, SEEK_CUR) != 0)
+    { builtin_error ("%s: %s", standard ? "standard input" : name, strerror (errno)); result = -1; }
+  if (fclose (fp) != 0) result = -1;
+  return result;
+open_error:
+  builtin_error ("%s: %s", standard ? "standard input" : name, strerror (errno));
+  return -1;
+}

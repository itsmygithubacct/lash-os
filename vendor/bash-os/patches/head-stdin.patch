@@ -86,8 +86,51 @@
 	  if (ch == '\n')
 	    break;
 	}
+      if (ch == EOF)
+        break;
+    }
+  if (ferror (fp))
+    {
+      builtin_error ("read error: %s", strerror (errno));
+      return EXECUTION_FAILURE;
     }
   return (EXECUTION_SUCCESS);
+}
+
+/* stdin's FILE belongs to the persistent shell. A private stream prevents
+   buffered bytes and EOF from surviving a redirection. Seek back unread bytes
+   on regular files; pipes must not read beyond the requested last line. */
+static int
+stdin_head (int nline)
+{
+  int fd, seekable, rval;
+  FILE *fp;
+
+  fd = dup (STDIN_FILENO);
+  if (fd < 0)
+    {
+      builtin_error ("stdin: %s", strerror (errno));
+      return EXECUTION_FAILURE;
+    }
+  fp = fdopen (fd, "r");
+  if (fp == NULL)
+    {
+      builtin_error ("stdin: %s", strerror (errno));
+      close (fd);
+      return EXECUTION_FAILURE;
+    }
+  seekable = lseek (fd, 0, SEEK_CUR) != (off_t)-1;
+  if (seekable == 0)
+    setvbuf (fp, NULL, _IONBF, 0);
+  rval = file_head (fp, nline);
+  if (seekable && fseeko (fp, 0, SEEK_CUR) != 0)
+    {
+      builtin_error ("stdin: %s", strerror (errno));
+      rval = EXECUTION_FAILURE;
+    }
+  if (fclose (fp) != 0)
+    rval = EXECUTION_FAILURE;
+  return rval;
 }
 

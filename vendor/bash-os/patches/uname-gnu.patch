+static int
+uname_longopt (const char *arg)
+{
+  static const char *names[] = {
+    "all", "kernel-name", "nodename", "kernel-release", "kernel-version",
+    "machine", "processor", "hardware-platform", "operating-system",
+    "help", "version", 0
+  };
+  static const int values[] = { 'a', 's', 'n', 'r', 'v', 'm', 'p', 'i', 'o', 'h', 'V' };
+  int i, match, count;
+  size_t len;
+
+  len = strlen (arg);
+  match = count = 0;
+  for (i = 0; names[i]; i++)
+    {
+      if (strcmp (names[i], arg) == 0)
+        return values[i];
+      if (len && strncmp (names[i], arg, len) == 0)
+        {
+          match = values[i];
+          count++;
+        }
+    }
+  return count == 1 ? match : -1;
+}
 

 	  queue_sigchld = 0;
+	  /* Non-POSIX wait does not return on SIGCHLD. Run the queued trap
+	     now that waitchld has finished the job list, before blocking
+	     for a child that the trap may release. */
+	  if (this_shell_builtin == wait_builtin && posixly_correct == 0)
+	    run_pending_traps ();
 	  if (r == -1 && errno == ECHILD && this_shell_builtin == wait_builtin)
 	    {
 	      termination_state = -1;
@@ -4248,9 +4253,11 @@
 	  if (sigchld == 0 && wait_intr_flag)
 	    sh_longjmp (wait_intr_buf, 1);

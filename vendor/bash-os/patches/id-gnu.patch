+/* Match exact names before accepting an unambiguous GNU long-option prefix. */
+static int
+id_longopt (const char *arg)
+{
+  static const char *names[] = {
+    "groups", "group", "name", "real", "user", "zero", "context",
+    "help", "version", 0
+  };
+  static const int values[] = { 'G', 'g', 'n', 'r', 'u', 'z', 'Z', 'h', 'V' };
+  int i, match, count;
+  size_t len;
+
+  len = strlen (arg);
+  match = count = 0;
+  for (i = 0; names[i]; i++)
+    {
+      if (strcmp (names[i], arg) == 0)
+        return values[i];
+      if (len && strncmp (names[i], arg, len) == 0)
+        {
+          match = values[i];
+          count++;
+        }
+    }
+  return count == 1 ? match : -1;
+}
+
+/* Resolve names first, then numeric UIDs (including GNU's leading '+').
+   Copy the canonical name before later passwd/group lookups reuse NSS storage. */
+static int
+id_inituser (const char *user, char **name)
+{
+  struct passwd *pwd;
+  const char *p;
+  char *end;
+  uintmax_t number;
+
+  *name = 0;
+  if (user == 0)
+    {
+      ruid = getuid ();
+      euid = geteuid ();
+      rgid = getgid ();
+      egid = getegid ();
+      return 0;
+    }
+  pwd = getpwnam (user);
+  if (pwd == 0)
+    {
+      p = user + (user[0] == '+');
+      if (*p)
+        {
+          for (; *p >= '0' && *p <= '9'; p++)
+            ;
+          if (*p == 0)
+            {
+              errno = 0;
+              number = strtoumax (user, &end, 10);
+              if (errno == 0 && *end == 0 && (uintmax_t)(uid_t)number == number)
+                pwd = getpwuid ((uid_t)number);
+            }
+        }
+    }
+  if (pwd == 0)
+    {
+      builtin_error ("%s: no such user", user);
+      return -1;
+    }
+  ruid = euid = pwd->pw_uid;
+  rgid = egid = pwd->pw_gid;
+  *name = savestring (pwd->pw_name);
+  return 0;
+}
+
+static int
+id_pruser (uid_t uid)
+{
+  struct passwd *pwd;
+
+  if (id_flags & ID_USENAME)
+    {
+      pwd = getpwuid (uid);
+      if (pwd)
+        {
+          printf ("%s", pwd->pw_name);
+          return 0;
+        }
+      builtin_error ("cannot find name for user ID %ju", (uintmax_t)uid);
+      printf ("%ju", (uintmax_t)uid);
+      return 1;
+    }
+  printf ("%ju", (uintmax_t)uid);
+  return 0;
+}
+
+static int
+id_prgrp (gid_t gid)
+{
+  struct group *grp;
+
+  if (id_flags & ID_USENAME)
+    {
+      grp = getgrgid (gid);
+      if (grp)
+        {
+          printf ("%s", grp->gr_name);
+          return 0;
+        }
+      builtin_error ("cannot find name for group ID %ju", (uintmax_t)gid);
+      printf ("%ju", (uintmax_t)gid);
+      return 1;
+    }
+  printf ("%ju", (uintmax_t)gid);
+  return 0;
+}
+
+static int
+id_gidcmp (const void *a, const void *b)
+{
+  gid_t x, y;
+
+  x = *(const gid_t *)a;
+  y = *(const gid_t *)b;
+  return (x > y) - (x < y);
+}
+
+/* Keep the real/effective primary groups first and deduplicate supplementary
+   IDs, including groups mapped to the same overflow ID in a user namespace. */
+static int
+id_groups (const char *name, gid_t **result)
+{
+  gid_t *groups, *raw;
+  int n, capacity, got, i, count;
+#if !defined (__linux__) && !defined (HAVE_GETGROUPLIST)
+  struct group *grp;
+  char **member;
+#endif
+
+  capacity = 16;
+  raw = (gid_t *)xmalloc (capacity * sizeof (gid_t));
+  if (name)
+    {
+#if defined (__linux__) || defined (HAVE_GETGROUPLIST)
+      for (;;)
+        {
+          n = capacity;
+          got = getgrouplist (name, rgid, raw, &n);
+          if (got >= 0)
+            break;
+          if (n <= capacity || n > INT_MAX / (int)sizeof (gid_t) - 2)
+            {
+              free (raw);
+              builtin_error ("cannot get groups for %s", name);
+              return -1;
+            }
+          capacity = n;
+          raw = (gid_t *)xrealloc (raw, capacity * sizeof (gid_t));
+        }
+#else
+      n = 0;
+      setgrent ();
+      while ((grp = getgrent ()) != 0)
+        for (member = grp->gr_mem; member && *member; member++)
+          if (strcmp (*member, name) == 0)
+            {
+              if (n == capacity)
+                {
+                  if (capacity > INT_MAX / (int)sizeof (gid_t) / 2)
+                    {
+                      endgrent ();
+                      free (raw);
+                      builtin_error ("too many groups for %s", name);
+                      return -1;
+                    }
+                  capacity *= 2;
+                  raw = (gid_t *)xrealloc (raw, capacity * sizeof (gid_t));
+                }
+              raw[n++] = grp->gr_gid;
+              break;
+            }
+      endgrent ();
+#endif
+    }
+  else
+    {
+      n = getgroups (0, (gid_t *)0);
+      if (n < 0 || n > INT_MAX / (int)sizeof (gid_t) - 2)
+        {
+          free (raw);
+          builtin_error ("cannot get supplementary groups: %s", strerror (errno));
+          return -1;
+        }
+      if (n > capacity)
+        raw = (gid_t *)xrealloc (raw, n * sizeof (gid_t));
+      /* Avoid a zero-size query being mistaken for populated storage. */
+      if (n > 0)
+        {
+          n = getgroups (n, raw);
+          if (n < 0)
+            {
+              free (raw);
+              builtin_error ("cannot get supplementary groups: %s", strerror (errno));
+              return -1;
+            }
+        }
+    }
+  qsort (raw, n, sizeof (gid_t), id_gidcmp);
+  groups = (gid_t *)xmalloc ((n + 2) * sizeof (gid_t));
+  count = 0;
+  groups[count++] = rgid;
+  if (egid != rgid)
+    groups[count++] = egid;
+  for (i = 0; i < n; i++)
+    if (raw[i] != rgid && raw[i] != egid && (i == 0 || raw[i] != raw[i-1]))
+      groups[count++] = raw[i];
+  free (raw);
+  *result = groups;
+  return count;
+}
+
+static void
+id_userfield (const char *label, uid_t uid)
+{
+  struct passwd *pwd;
+
+  printf ("%s=%ju", label, (uintmax_t)uid);
+  pwd = getpwuid (uid);
+  if (pwd)
+    printf ("(%s)", pwd->pw_name);
+}
+
+static void
+id_groupfield (gid_t gid)
+{
+  struct group *grp;
+
+  printf ("%ju", (uintmax_t)gid);
+  grp = getgrgid (gid);
+  if (grp)
+    printf ("(%s)", grp->gr_name);
+}
+
+static int
+id_print (const char *user, int *printed)
+{
+  char *name;
+  gid_t *groups;
+  int n, i, status, separator;
+
+  *printed = 0;
+  if (id_inituser (user, &name) < 0)
+    return 1;
+  status = 0;
+  separator = (id_flags & ID_ZERO) ? '\0' : ' ';
+  if (id_flags & ID_USERONLY)
+    status = id_pruser ((id_flags & ID_USEREAL) ? ruid : euid);
+  else if (id_flags & ID_GIDONLY)
+    status = id_prgrp ((id_flags & ID_USEREAL) ? rgid : egid);
+  else
+    {
+      n = id_groups (name, &groups);
+      if (n < 0)
+        {
+          free (name);
+          return 1;
+        }
+      if (id_flags & ID_ALLGROUPS)
+        {
+          for (i = 0; i < n; i++)
+            {
+              if (i)
+                putchar (separator);
+              status |= id_prgrp (groups[i]);
+            }
+        }
+      else
+        {
+          id_userfield ("uid", ruid);
+          printf (" gid=");
+          id_groupfield (rgid);
+          if (euid != ruid)
+            id_userfield (" euid", euid);
+          if (egid != rgid)
+            {
+              printf (" egid=");
+              id_groupfield (egid);
+            }
+          printf (" groups=");
+          for (i = 0; i < n; i++)
+            {
+              if (i)
+                putchar (',');
+              id_groupfield (groups[i]);
+            }
+        }
+      free (groups);
+    }
+  free (name);
+  *printed = 1;
+  putchar ((id_flags & ID_ZERO) ? '\0' : '\n');
+  return status;
+}
 

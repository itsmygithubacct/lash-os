 extern char **export_env;
 
+/* Read the exported environment, including temporary command assignments.
+   A shell variable lookup would miss non-identifier environment names. */
+static char *
+printenv_value (const char *name)
+{
+  char **entry;
+  size_t length = strlen (name);
+  if (strchr (name, '='))
+    return 0;
+  for (entry = export_env; *entry; entry++)
+    if (strncmp (*entry, name, length) == 0 && (*entry)[length] == '=')
+      return *entry + length + 1;
+  return 0;
+}

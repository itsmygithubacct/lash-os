 extern char	*sh_realpath(const char *, char *);
 
+/* GNU's default permits a missing final component, including the target of
+   a dangling final symlink. Resolve every parent before accepting that leaf. */
+static char *
+realpath_leaf (const char *path, unsigned int links)
+{
+  char *resolved, *copy, *slash, *leaf, *parent, *joined, *target, link[PATH_MAX + 1];
+  struct stat st;
+  size_t length;
+  ssize_t count;
+  int error;
+
+  resolved = realpath (path, 0);
+  if (resolved || errno != ENOENT || *path == 0) return resolved;
+  if (links >= 40) { errno = ELOOP; return 0; }
+  copy = savestring (path);
+  length = strlen (copy);
+  while (length > 1 && copy[length - 1] == '/') copy[--length] = 0;
+  slash = strrchr (copy, '/');
+  leaf = slash ? slash + 1 : copy;
+  if (STREQ (leaf, ".") || STREQ (leaf, ".."))
+    { free (copy); errno = ENOENT; return 0; }
+  if (slash) *slash = 0;
+  parent = realpath (slash ? (slash == copy ? "/" : copy) : ".", 0);
+  if (parent == 0) { free (copy); return 0; }
+  if (stat (parent, &st) < 0 || !S_ISDIR (st.st_mode))
+    { free (parent); free (copy); errno = ENOTDIR; return 0; }
+  joined = sh_makepath (parent, leaf, 0);
+  free (copy);
+  if (lstat (joined, &st) == 0)
+    {
+      if (S_ISLNK (st.st_mode))
+        {
+          count = readlink (joined, link, sizeof link - 1);
+          error = errno;
+          if (count < 0)
+            { free (joined); free (parent); errno = error; return 0; }
+          if (count == sizeof link - 1)
+            { free (joined); free (parent); errno = ENAMETOOLONG; return 0; }
+          link[count] = 0;
+          target = make_absolute (link, parent);
+          free (joined);
+          joined = realpath_leaf (target, links + 1);
+          free (target);
+        }
+    }
+  else if (errno != ENOENT)
+    { error = errno; free (joined); joined = 0; errno = error; }
+  free (parent);
+  return joined;
+}
+
+static char *
+realpath_lexical (const char *path)
+{
+  char *cwd, *absolute, *p, *result;
+  struct stat st;
+  int error;
+
+  if (*path == 0) { errno = ENOENT; return 0; }
+  cwd = getcwd (0, 0);
+  if (cwd == 0) return 0;
+  absolute = make_absolute ((char *)path, cwd);
+  free (cwd);
+  /* A nonexistent prefix is allowed in -s mode, but an existing regular
+     file cannot serve as a directory. Keep dot-dot existence checks too. */
+  for (p = absolute + 1; *p; p++)
+    if (*p == '/' && p[-1] != '/')
+      {
+        *p = 0;
+        if (stat (absolute, &st) == 0)
+          {
+            if (!S_ISDIR (st.st_mode))
+              { free (absolute); errno = ENOTDIR; return 0; }
+          }
+        else if (errno != ENOENT)
+          { error = errno; free (absolute); errno = error; return 0; }
+        *p = '/';
+      }
+  result = sh_canonpath (absolute, PATH_CHECKDOTDOT);
+  free (absolute);
+  if (result && result[0] == '/' && result[1] == '/')
+    memmove (result, result + 1, strlen (result));
+  return result;
+}

 #include "bashgetopt.h"
 
+static void
+dirname_output (const char *path, int delimiter)
+{
+  size_t end = strlen (path);
+  if (end == 0)
+    { putchar ('.'); putchar (delimiter); return; }
+  while (end && path[end - 1] == '/') end--;
+  if (end == 0)
+    { putchar ('/'); putchar (delimiter); return; }
+  while (end && path[end - 1] != '/') end--;
+  if (end == 0)
+    { putchar ('.'); putchar (delimiter); return; }
+  while (end && path[end - 1] == '/') end--;
+  if (end) fwrite (path, 1, end, stdout);
+  else putchar ('/');
+  putchar (delimiter);
+}

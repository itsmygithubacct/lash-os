+/* Explicit -i reads only its own answers, without stdio read-ahead or
+   invoking an external rm. Memory use does not depend on answer length. */
+static int
+rm_confirm (const char *action, const char *name)
+{
+  unsigned char c = 0, first = 0;
+  int have_first = 0;
+  ssize_t n;
+
+  if (fprintf (stderr, "rm: %s '%s'? ", action, name) < 0
+      || fflush (stderr) == EOF)
+    return -1;
+  for (;;)
+    {
+      QUIT;
+      n = read (STDIN_FILENO, &c, 1);
+      if (n < 0)
+        {
+          if (errno == EINTR) continue;
+          builtin_error ("confirmation: %s", strerror (errno));
+          return -1;
+        }
+      if (n == 0 || c == '\n') break;
+      if (have_first == 0) { first = c; have_first = 1; }
+    }
+  return have_first && (first == 'y' || first == 'Y');
+}
+
+static void
+rm_close_directory (void *arg)
+{
+  closedir ((DIR *) arg);
+}
+
+static int
+rm_interactive_file (const char *fname)
+{
+  struct stat st;
+  int answer, err;
+  DIR *dir;
+  struct dirent *dp;
+
+  if (lstat (fname, &st) < 0)
+    {
+      builtin_error ("%s: %s", fname, strerror (errno));
+      return 1;
+    }
+  if (S_ISDIR (st.st_mode) == 0)
+    {
+      answer = rm_confirm ("remove", fname);
+      if (answer <= 0) return answer < 0;
+      if (unlink (fname) == 0) return 0;
+      builtin_error ("%s: %s", fname, strerror (errno));
+      return 1;
+    }
+  if (recursive == 0)
+    {
+      builtin_error ("%s: %s", fname, strerror (EISDIR));
+      return 1;
+    }
+  dir = opendir (fname);
+  if (dir == 0)
+    {
+      builtin_error ("%s: %s", fname, strerror (errno));
+      return 1;
+    }
+  begin_unwind_frame ("rm interactive directory");
+  add_unwind_protect (rm_close_directory, dir);
+  do
+    dp = readdir (dir);
+  while (dp && (strcmp (dp->d_name, ".") == 0 || strcmp (dp->d_name, "..") == 0));
+  if (dp)
+    {
+      answer = rm_confirm ("descend into directory", fname);
+      if (answer <= 0)
+        {
+          run_unwind_frame ("rm interactive directory");
+          return answer < 0;
+        }
+    }
+  err = 0;
+  while (dp)
+    {
+      if (strcmp (dp->d_name, ".") && strcmp (dp->d_name, ".."))
+        {
+          size_t len = strlen (fname) + strlen (dp->d_name) + 2;
+          char child[len];
+          snprintf (child, len, "%s/%s", fname, dp->d_name);
+          if (rm_interactive_file (child)) err = 1;
+        }
+      dp = readdir (dir);
+    }
+  run_unwind_frame ("rm interactive directory");
+  answer = rm_confirm ("remove directory", fname);
+  if (answer <= 0) return err || answer < 0;
+  if (rmdir (fname) < 0)
+    {
+      builtin_error ("%s: %s", fname, strerror (errno));
+      return 1;
+    }
+  return err;
+}
